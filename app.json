{
  "expo": {
    "name": "RoomLink",
    "slug": "roomlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "roomlink",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F2554",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.roomlink.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ph.roomlink.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "RoomLink needs access to your photos so you can add pictures to a room listing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
