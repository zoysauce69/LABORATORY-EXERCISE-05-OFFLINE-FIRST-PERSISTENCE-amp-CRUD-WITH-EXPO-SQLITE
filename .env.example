# ---------------------------------------------------------------------------
# RoomLink environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.
#
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# NEVER put the Supabase service_role key in this file or anywhere in the app.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase Dashboard -> Project Settings -> Data API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
# This key is safe to ship in the client: Row Level Security is what protects
# the data. Never use the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional: distance provider
# ---------------------------------------------------------------------------
# RoomLink ships with a local straight-line (Haversine) distance calculator so
# that the "distance from school/workplace" filter works with zero credentials.
# Distances derived this way are labelled "approx." in the UI and are never
# presented as GPS-verified or driving distances.
#
# To enable a real routing provider, set the key below and set
# EXPO_PUBLIC_DISTANCE_MODE=routes. See docs/LOCATION_SERVICE.md.
EXPO_PUBLIC_DISTANCE_MODE=straightline
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=